APP_NAME="mini-RAG"
APP_VERSION="0.1.0"

FILE_ALLOWED_TYPES=["text/plain","application/pdf"]
FILE_MAX_SIZE_MB=10

FILE_DEFAULT_CHUNK_SIZE_MB=512

MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="mini-rag-db"

# ========================== LLM CONFIGURATION ==========================
GENERATION_BACKEND="OPENAI" # Options: COHERE, OPENAI
EMBEDDING_BACKEND="OPENAI" # Options: COHERE, OPENAI

OPENAI_API_KEY=""
COHERE_API_KEY=""

OPENAI_API_BASE_URL=""

LLM_ID=""
EMBEDDING_MODEL_ID=""
EMBEDDING_MODEL_SIZE=384

DEFAULT_MAX_INPUT_CARACTERS=1024
DEFAULT_OUTPUT_MAX_TOKENS=1000
DEFAULT_TEMPERATURE=0.1
